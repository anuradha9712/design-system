{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 5000
    },
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "docs",
      "port": 8000
    },
    {
      "name": "reel",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "reel", "-p", "3000"],
      "port": 3000
    }
  ]
}
